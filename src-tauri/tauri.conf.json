{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Relay",
  "version": "1.1.1",
  "identifier": "eu.stealthylabs.relay",
  "build": {
    "frontendDist": "../gui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: data: https://cdn.discordapp.com https://media.discordapp.net; connect-src http://127.0.0.1:* ws://127.0.0.1:*; frame-src http://127.0.0.1:*"
    },
    "windows": [
      {
        "label": "main",
        "title": "Relay",
        "url": "panel.html",
        "width": 1120,
        "height": 760,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Local Discord media relay for OBS",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
